# Copy to /etc/rsi-alert.env and chmod 600 (it holds secrets).

# --- alerting -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:replace-me       # from @BotFather
TELEGRAM_CHAT_ID=-1001234567890            # your chat or channel id

# --- optional -------------------------------------------------------------
# A free demo key drops CoinGecko pacing from 8s to 2s between calls.
#COINGECKO_API_KEY=

# Only needed where api.binance.com is geoblocked (US datacenters). The public
# data mirror serves the same klines and tickers without an account.
#BINANCE_PUBLIC_URL=https://data-api.binance.vision/api/v3

# --- what the scan actually does -----------------------------------------
# Edit freely; the unit passes this straight through.
RSI_FLAGS=--top-n 200 --timeframes 4h 1d --lookback-days 30 --show-mcap --telegram --html /var/lib/rsi-alert/site/index.html --json /var/lib/rsi-alert/site/data.json --csv-dir /var/lib/rsi-alert/csv
